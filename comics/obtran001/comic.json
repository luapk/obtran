  "text": {
    "title": "Oblivious Transfer 001",
    "description": "OBTRAN 001 comic page from Oblivious Transfer, read as an interactive 3D page.",
    "heading": "Oblivious Transfer: OBTRAN 001",
    "code": "OBTRAN001",
    "lead": "Turn your sound on and follow the story, exploring to unlock tracks.",
    "musicTab": "QNTM CTRL",
    "musicBuy": "The Eagle and the Senses EP on Bandcamp",
    "triggerHint": "DECODE PROTOCOL",
    "breachPage": "Decode protocol. The page breaks apart and you fall through the eye.",
    "breachSpace": "Decode protocol. The space breaks apart and you fall through the eye.",
    "cctvDate": "3089.01.01"
  },
  "beats": [
    {
      "b": "lyra",
      "note": "EPSILON CYGNI, 3089 AD. ALL LIFE ON THE EXOPLANET LYRA HAS BEEN OBLITERATED..."
    },
    {
      "b": "vessel",
      "note": "...APART FROM THE HOLOSONIC VESSEL QNTM CNTRL...",
      "filmOnly": true,
      "auto": 1.0,
      "why": "Paul, 25 October: the escape film plays instead of the illustrated scene, once, full screen, its caption over it, resting on its last frame while the line finishes; then on into the cockpit (the vessel world is no longer in the walk)"
    },
    {
      "b": "lifeform",
      "note": "...A DNA-ENCRYPTED LIFEFORM! ... THE OBLIVIOUS TRANSFER!",
      "glyphs": true,
      "glyphsWhy": "Paul, 25 October: no blurry cockpit world behind the caption; OBTRAN 003's scrambling glyph field instead, as it matches the voice over (the encryption)",
      "cardScale": 2
    },
    {
      "b": "manifold",
      "note": "FOUR-DIMENSIONAL MANIFOLD ENABLED, QNTM CNTRL TRAVERSES THE EXPANSE OF CYGNUS A...",
      "fold": true,
      "why": "Paul, 25 October: the reader drags to fold the manifold's slabs together; when the creases meet the ship slingshots through (to build)"
    },
    {
      "b": "patrol",
      "note": "OUR FALLEN SHIP IS INTERCEPTED BY A SCOUT PATROL FROM AN ANCIENT TRIBE."
    },
    {
      "b": "plunder",
      "note": "THEIR PLUNDER OF QNTM CTRL'S HOLD RETRIEVES URANIUM AND THE INVALUABLE CRYPTID, STILL DEEP IN HYPERSLEEP.",
      "outSpin": {
        "prop": "pod",
        "secs": 3
      },
      "outSpinWhy": "Paul, 25 October: on the transition before metabolic stasis, the pod spinning slowly above the vortex, 3 s longer"
    },
    {
      "b": "ritual",
      "note": "IN METABOLIC STASIS, THE PSYCHEDELIC VIBRATIONS OF THEIR BONFIRE RITUAL...",
      "drum": true,
      "why": "Paul, 25 October: the reader taps in time with the music; on-beat taps flare the fire and the pod; about eight good hits trigger the decode (to build)"
    },
    {
      "b": "decode",
      "note": "...WOULD SOON TRIGGER OBTRAN TO BEGIN ITS DECODE PROTOCOL.",
      "trigger": true,
      "auto": 1.8
    }
