{"aspect": 1.3521956970232831, "centre": [0.455, 0.42523430688753266], "bubbles": [{"id": "caption", "uv": [0.02468, 0.00907, 0.32335, 0.08341], "speaker": "narrator", "text": "Canes Crescenza, 3091 AD. Spomenik Operative Bob sips his morning coffee, when suddenly the vessel's transmitter erupts...", "poly": [[0.03804, 0.01203], [0.31935, 0.01203], [0.30944, 0.08045], [0.02868, 0.08038]]}, {"id": "crsh", "uv": [0.48951, 0.09561, 0.74431, 0.13628], "speaker": "transmitter", "text": "CRSSHKKKKK!", "poly": [[0.514, 0.10058], [0.74031, 0.09857], [0.7148, 0.13331], [0.49351, 0.13332], [0.49722, 0.11238]]}, {"id": "smoke1", "uv": [0.58478, 0.12534, 0.92554, 0.19052], "speaker": "smokehouse", "text": "Smokehouse Shift for Bob, this is Smokehouse Shift for Bob. You are cleared to initiate your Pulsar Protocol.", "poly": [[0.5988, 0.13151], [0.92154, 0.1283], [0.91018, 0.18755], [0.58878, 0.18756]]}, {"id": "engage", "uv": [0.73937, 0.19594, 0.94428, 0.24829], "speaker": "smokehouse", "text": "Engage Chemical Digital Cryptoflage!", "poly": [[0.77691, 0.19893], [0.94028, 0.1989], [0.93171, 0.23441], [0.90591, 0.24526], [0.74337, 0.24533], [0.75, 0.21742]]}, {"id": "bob1", "uv": [0.35199, 0.23912, 0.67552, 0.31368], "speaker": "bob", "text": "W-what the hell Smokehouse? I've been out here for like, 3 kalpas metascanning intergalactic tumbleweed. Are you winding...", "poly": [[0.3681, 0.24219], [0.67152, 0.24208], [0.66166, 0.30124], [0.64351, 0.31072], [0.35599, 0.31048]]}, {"id": "drill", "uv": [0.70115, 0.50307, 0.95524, 0.57747], "speaker": "smokehouse", "text": "This is not a drill, Bob. Engage the Spomenik Transfer Protocol. Just like you were trained to do.", "poly": [[0.71289, 0.50616], [0.95124, 0.50603], [0.9417, 0.55546], [0.90327, 0.57451], [0.70515, 0.57443]]}, {"id": "unlock", "uv": [0.57649, 0.61014, 0.91018, 0.6428], "speaker": "smokehouse", "text": "Unlock your biometric key, Bob.", "poly": [[0.58608, 0.6131], [0.90618, 0.61312], [0.89934, 0.63982], [0.58049, 0